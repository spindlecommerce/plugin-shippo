{
  "name": "@spindlecommerce/plugin-shippo",
  "version": "1.0.0",
  "description": "Shippo for SpindleCommerce: live carrier rates at checkout (USPS, UPS, FedEx, DHL and more) and shipping labels when you fulfil orders.",
  "keywords": [
    "spindlecommerce",
    "spindlecommerce-plugin",
    "shippo",
    "shipping",
    "shipping-labels"
  ],
  "homepage": "https://github.com/spindlecommerce/plugin-shippo#readme",
  "bugs": "https://github.com/spindlecommerce/plugin-shippo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spindlecommerce/plugin-shippo.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.12"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@spindlecommerce/plugin-sdk": "^1.0.0"
  },
  "devDependencies": {
    "@spindlecommerce/plugin-sdk": "^1.0.0",
    "@types/node": "^24",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
